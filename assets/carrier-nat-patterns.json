{
  "description": "运营商NAT IP段检测模式配置文件",
  "usage": "用于检测对方IP是否为运营商NAT地址，触发网关爆破优化",
  "patterns": [
    {
      "name": "RFC1918 - 10.0.0.0/8",
      "cidr": "10.0.0.0/8",
      "regex": "^10\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$",
      "description": "私有A类地址，常用于运营商NAT"
    },
    {
      "name": "RFC6598 - Carrier-Grade NAT 100.64.0.0/10",
      "cidr": "100.64.0.0/10",
      "regex": "^100\\.(?:6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$",
      "description": "运营商级NAT地址段 (CGNAT)"
    }
  ],
  "detection": {
    "enabled": true,
    "triggerOnConnectionFailure": true,
    "maxGatewayAttempts": 254,
    "defaultPortPreservation": true
  },
  "gateway": {
    "defaultRange": "192.168.1-255.1",
    "template": "{prefix}.{suffix}",
    "description": "网关爆破范围，{prefix}为192.168，{suffix}为1-255，最后固定为.1"
  }
}